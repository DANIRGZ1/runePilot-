{
  "name": "runepilot",
  "version": "1.1.0",
  "description": "League of Legends Draft Analyzer with LCU integration and meta builds",
  "scripts": {
    "start": "vite",
    "server": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm start\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.1"
  },
  "serverDependencies": {
    "express": "^4.18.2",
    "ws": "^8.16.0",
    "cors": "^2.8.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "notes": {
    "lcu": "Backend uses Riot's local LCU API for match detection — personal use only per Riot policy",
    "data": "Champion data from Riot Data Dragon (official CDN). Builds are community-curated meta knowledge.",
    "opgg": "op.gg has no public API. We use Riot Data Dragon + curated high-elo builds instead."
  }
}
